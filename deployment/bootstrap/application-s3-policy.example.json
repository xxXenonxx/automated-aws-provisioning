{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSelectedBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_SELECTED_BUCKET"
    },
    {
      "Sid": "ManageDemoObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_SELECTED_BUCKET/images/*"
    }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Deny",
      "Action": [
        "ec2:AssociateIamInstanceProfile",
        "ec2:AssociateRouteTable",
        "ec2:AttachInternetGateway",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:CreateRoute",
        "ec2:CreateTags",
        "ec2:DeleteRoute",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteTags",
        "ec2:DisassociateRouteTable",
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifyInstanceMetadataOptions",
        "ec2:ModifySecurityGroupRules",
        "ec2:ModifySubnetAttribute",
        "ec2:ModifyVpcAttribute",
        "ec2:RebootInstances",
        "ec2:ReplaceIamInstanceProfileAssociation",
        "ec2:ReplaceRoute",
        "ec2:ReplaceRouteTableAssociation",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RunInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:UpdateSecurityGroupRuleDescriptionsEgress",
        "ec2:UpdateSecurityGroupRuleDescriptionsIngress"
      ],
      "Resource": [
        "arn:aws:ec2:REGION:ACCOUNT_ID:instance/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:internet-gateway/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:route-table/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:security-group/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Role": "control-node"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeIamInstanceProfileAssociations",
        "ec2:DescribeImages",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstances",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeTags",
        "ec2:DescribeVolumes",
        "ec2:DescribeVpcs",
        "rds:DescribeDBEngineVersions",
        "rds:DescribeDBMajorEngineVersions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "pricing:GetProducts",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "PROJECT_NAME",
          "aws:RequestTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:REGION:ACCOUNT_ID:instance/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:volume/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:security-group/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:vpc/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:internet-gateway/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateSecurityGroup",
            "CreateVpc",
            "CreateSubnet",
            "CreateInternetGateway",
            "CreateRouteTable"
          ],
          "aws:RequestTag/Project": "PROJECT_NAME",
          "aws:RequestTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstanceAttribute",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:UpdateSecurityGroupRuleDescriptionsIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:ModifyInstanceMetadataOptions"
      ],
      "Resource": [
        "arn:aws:ec2:REGION:ACCOUNT_ID:instance/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "PROJECT_NAME",
          "ec2:ResourceTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:InstanceType": "APP_INSTANCE_TYPE",
          "aws:RequestTag/Project": "PROJECT_NAME",
          "aws:RequestTag/Environment": "ENVIRONMENT_NAME",
          "aws:RequestTag/Role": [
            "application",
            "provisioned-server"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "PROJECT_NAME",
          "aws:RequestTag/Environment": "ENVIRONMENT_NAME",
          "aws:RequestTag/Role": [
            "application",
            "provisioned-server"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:security-group/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "PROJECT_NAME",
          "ec2:ResourceTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances",
        "rds:DescribeDBSubnetGroups",
        "rds:ListTagsForResource",
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance",
        "rds:CreateDBSubnetGroup",
        "rds:ModifyDBSubnetGroup",
        "rds:AddTagsToResource",
        "rds:RemoveTagsFromResource"
      ],
      "Resource": [
        "arn:aws:rds:REGION:ACCOUNT_ID:db:DB_IDENTIFIER",
        "arn:aws:rds:REGION:ACCOUNT_ID:subgrp:DB_SUBNET_GROUP_NAME",
        "arn:aws:rds:REGION:ACCOUNT_ID:pg:default.mysql*",
        "arn:aws:rds:REGION:ACCOUNT_ID:og:default:mysql-*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucketTagging",
        "s3:GetBucketLocation",
        "s3:PutBucketTagging",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketOwnershipControls",
        "s3:PutBucketOwnershipControls",
        "s3:GetBucketAcl",
        "s3:GetBucketPolicy",
        "s3:GetBucketRequestPayment",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetInventoryConfiguration",
        "s3:GetBucketLogging"
      ],
      "Resource": "arn:aws:s3:::BUCKET_NAME"
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateVpc",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION",
          "aws:RequestTag/Project": "PROJECT_NAME",
          "aws:RequestTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateSubnet",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:subnet/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION",
          "aws:RequestTag/Project": "PROJECT_NAME",
          "aws:RequestTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateInternetGateway",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:internet-gateway/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION",
          "aws:RequestTag/Project": "PROJECT_NAME",
          "aws:RequestTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateRouteTable",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:route-table/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION",
          "aws:RequestTag/Project": "PROJECT_NAME",
          "aws:RequestTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION",
          "ec2:ResourceTag/Project": "PROJECT_NAME",
          "ec2:ResourceTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcAttribute",
        "ec2:ModifyVpcAttribute"
      ],
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION",
          "ec2:ResourceTag/Project": "PROJECT_NAME",
          "ec2:ResourceTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:ModifySubnetAttribute",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:subnet/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION",
          "ec2:ResourceTag/Project": "PROJECT_NAME",
          "ec2:ResourceTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:AttachInternetGateway",
      "Resource": [
        "arn:aws:ec2:REGION:ACCOUNT_ID:vpc/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:internet-gateway/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION",
          "ec2:ResourceTag/Project": "PROJECT_NAME",
          "ec2:ResourceTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRoute",
        "ec2:ReplaceRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:ReplaceRouteTableAssociation",
        "ec2:DisassociateRouteTable"
      ],
      "Resource": [
        "arn:aws:ec2:REGION:ACCOUNT_ID:route-table/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:subnet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION",
          "ec2:ResourceTag/Project": "PROJECT_NAME",
          "ec2:ResourceTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": [
        "arn:aws:ec2:REGION:ACCOUNT_ID:vpc/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:internet-gateway/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION",
          "ec2:ResourceTag/Project": "PROJECT_NAME",
          "ec2:ResourceTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:REGION::image/AMI_ID",
        "arn:aws:ec2:REGION:ACCOUNT_ID:key-pair/APP_KEY_PAIR_NAME"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:subnet/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION",
          "ec2:ResourceTag/Project": "PROJECT_NAME",
          "ec2:ResourceTag/Environment": "ENVIRONMENT_NAME"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:network-interface/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION"
        },
        "ArnLike": {
          "ec2:Subnet": "arn:aws:ec2:REGION:ACCOUNT_ID:subnet/*"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateIamInstanceProfile",
        "ec2:ReplaceIamInstanceProfileAssociation"
      ],
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION",
          "ec2:ResourceTag/Project": "PROJECT_NAME",
          "ec2:ResourceTag/Environment": "ENVIRONMENT_NAME",
          "ec2:ResourceTag/Role": "application"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetInstanceProfile",
        "iam:GetRole"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:instance-profile/APP_INSTANCE_PROFILE_NAME",
        "arn:aws:iam::ACCOUNT_ID:role/APP_ROLE_NAME"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iam:ListInstanceProfiles",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/APP_ROLE_NAME",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}
